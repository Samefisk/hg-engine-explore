{
  "schemaVersion": 1,
  "id": "mount.select-during-follower-switch",
  "title": "Mount and dismount Stantler, then one Select during follower switch mounts Mankey",
  "mode": "normal",
  "fixture": {"rom": "test.nds", "save": "test.sav"},
  "expectationSource": "tests/overworld/scenarios/mount.select-during-follower-switch.json",
  "requirements": ["current.mount-select-during-follower-switch"],
  "budgets": {"maxSeconds": 90, "maxFrames": 300, "noProgressFrames": 150, "minObservedFrames": 1},
  "subjects": [{"id": "mankey", "species": 56, "role": "MOUNTED", "acquire": "existing"}],
  "setup": [],
  "actions": [
    {"id": "wait-saved-stantler", "op": "wait", "args": {"predicate": {"kind": "follower-settled", "species": 234, "partySlot": 0}},
     "budget": {"maxSeconds": 10, "maxFrames": 90, "noProgressFrames": 90}},
    {"id": "press-select-mount-stantler", "op": "step", "args": {"frames": 1, "keys": ["SELECT"]},
     "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}},
    {"id": "release-select-mount", "op": "step", "args": {"frames": 4, "keys": []},
     "budget": {"maxSeconds": 5, "maxFrames": 4, "noProgressFrames": 4}},
    {"id": "press-select-dismount-stantler", "op": "step", "args": {"frames": 1, "keys": ["SELECT"]},
     "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}},
    {"id": "wait-stantler-follower", "op": "wait", "args": {"predicate": {"kind": "follower-settled", "species": 234, "partySlot": 0}},
     "budget": {"maxSeconds": 10, "maxFrames": 60, "noProgressFrames": 60}},
    {"id": "open-selector", "op": "step", "args": {"frames": 6, "keys": ["Y"], "until": {"kind": "selector-field", "path": "state", "operator": "eq", "value": 2}},
     "budget": {"maxSeconds": 5, "maxFrames": 6, "noProgressFrames": 6}},
    {"id": "release-y", "op": "step", "args": {"frames": 1, "keys": []},
     "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}},
    {"id": "highlight-mankey", "op": "step", "args": {"frames": 6, "keys": ["R"], "until": {"kind": "selector-field", "path": "highlight", "operator": "eq", "value": 2}},
     "budget": {"maxSeconds": 5, "maxFrames": 6, "noProgressFrames": 6}},
    {"id": "confirm-mankey", "op": "step", "args": {"frames": 6, "keys": ["Y"], "until": {"kind": "selector-field", "path": "state", "operator": "eq", "value": 0}},
     "budget": {"maxSeconds": 5, "maxFrames": 6, "noProgressFrames": 6}},
    {"id": "release-confirm", "op": "step", "args": {"frames": 1, "keys": []},
     "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}},
    {"id": "press-select-during-switch", "op": "step", "args": {"frames": 1, "keys": ["SELECT"]},
     "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}},
    {"id": "wait-one-press-mount", "op": "wait", "args": {"predicate": {"kind": "actor-present", "subject": "mankey"}},
     "budget": {"maxSeconds": 25, "maxFrames": 120, "noProgressFrames": 120}},
    {"id": "bind-mounted-mankey", "op": "bind", "args": {"subject": "mankey"},
     "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}},
    {"id": "observe-mounted-mankey", "op": "step", "args": {"frames": 1, "keys": []},
     "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}}
  ],
  "assertions": [
    {"kind": "actor-field", "subject": "mankey", "path": "identityVerified", "operator": "eq", "value": true, "when": "always"},
    {"kind": "actor-field", "subject": "mankey", "path": "presentationAttached", "operator": "eq", "value": true, "when": "always"},
    {"kind": "actor-field", "subject": "mankey", "path": "inputOwnership", "operator": "eq", "value": 1, "when": "always"},
    {"kind": "selector-field", "path": "activeFollowerPartySlot", "operator": "eq", "value": 2},
    {"kind": "frame-count", "operator": "gte", "value": 1}
  ]
}
