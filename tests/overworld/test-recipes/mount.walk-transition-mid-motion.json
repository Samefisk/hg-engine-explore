    {"id": "prepare-own-cyndaquil", "op": "party", "args": {"slot": 0, "species": 155, "level": 10, "hp": 1, "status": 0},
      "budget": {"maxSeconds": 15, "maxFrames": 30, "noProgressFrames": 30}},
    {"id": "mount-own-cyndaquil", "op": "spawn", "args": {"species": 155, "form": 0, "role": "mounted", "slot": 0, "level": 10},
      "budget": {"maxSeconds": 30, "maxFrames": 120, "noProgressFrames": 120}},
    {"id": "settle-current-mount", "op": "step", "args": {"frames": 16, "keys": []},
      "budget": {"maxSeconds": 15, "maxFrames": 16, "noProgressFrames": 16}},
    {"id": "bind-cyndaquil", "op": "bind", "args": {"subject": "cyndaquil"},
      "budget": {"maxSeconds": 5, "maxFrames": 1, "noProgressFrames": 1}}
