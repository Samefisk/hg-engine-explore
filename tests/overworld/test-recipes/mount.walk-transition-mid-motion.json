{
  "schemaVersion": 1,
  "id": "mount.walk-transition-mid-motion",
  "title": "A mounted Walk completes after the Route 29 field transition",
  "mode": "prepared",
  "fixture": {"rom": "test.nds", "save": "test.sav"},
