  "requirements": ["legacy.mounted-walk-transition"],
  "budgets": {"maxSeconds": 90, "maxFrames": 120, "noProgressFrames": 48, "minObservedFrames": 24},
  "subjects": [{"id": "cyndaquil", "species": 155, "role": "MOUNTED", "acquire": "existing"}],
