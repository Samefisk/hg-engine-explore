{
  "schemaVersion": 1,
  "id": "population.spawn-work-budget",
  "title": "Automatic spawn work keeps zero late main loops",
  "mode": "normal",
  "fixture": {
    "rom": "test.nds",
    "save": "test.sav"
  },
  "expectationSource": "documentation/overworld-system/verification.md#spawn-work-budget-and-proof-freshness",
  "requirements": [
    "shared.spawn-work-budget-v1"
  ],
  "budgets": {
    "maxSeconds": 180,
    "maxFrames": 360,
    "noProgressFrames": 320,
    "minObservedFrames": 120
  },
  "subjects": [
    {
      "id": "mankey",
      "species": 56,
      "role": "FOLLOWER",
      "acquire": "existing"
    }
  ],
  "setup": [
    {
      "id": "current-follower",
      "op": "wait",
      "args": {
        "predicate": {
          "kind": "actor-present",
          "subject": "mankey"
        }
      },
      "budget": {
        "maxSeconds": 30,
        "maxFrames": 64,
        "noProgressFrames": 64
      }
    },
    {
      "id": "bind-current-field",
      "op": "bind",
      "args": {
        "subject": "mankey"
      },
      "budget": {
        "maxSeconds": 10,
        "maxFrames": 1,
        "noProgressFrames": 1
      }
    }
  ],
  "actions": [
    {
      "id": "route-up",
      "op": "step",
      "args": {
        "frames": 64,
        "keys": ["UP"],
        "until": {
          "kind": "player-step-count",
          "operator": "eq",
          "value": 8
        }
      },
      "budget": {"maxSeconds": 30, "maxFrames": 64, "noProgressFrames": 32}
    },
    {
      "id": "route-left-city", "op": "step",
      "args": {"frames": 128, "keys": ["LEFT"], "until": {
        "kind": "player-step-count", "operator": "eq", "value": 28}},
      "budget": {"maxSeconds": 50, "maxFrames": 128, "noProgressFrames": 32}
    },
    {
      "id": "route-up-city", "op": "step",
      "args": {"frames": 64, "keys": ["UP"], "until": {
        "kind": "player-step-count", "operator": "eq", "value": 33}},
      "budget": {"maxSeconds": 30, "maxFrames": 64, "noProgressFrames": 32}
    },
    {
      "id": "route-left-window", "op": "step",
      "args": {"frames": 128, "keys": ["LEFT"], "until": {
        "kind": "player-step-count", "operator": "eq", "value": 55}},
      "budget": {"maxSeconds": 50, "maxFrames": 128, "noProgressFrames": 32}
    },
    {
      "id": "route-down-window", "op": "step",
      "args": {"frames": 64, "keys": ["DOWN"], "until": {
        "kind": "player-step-count", "operator": "eq", "value": 64}},
      "budget": {"maxSeconds": 30, "maxFrames": 64, "noProgressFrames": 32}
    }
  ],
  "assertions": [
    {
      "kind": "measurement-complete",
      "measurement": "spawn-work-budget-v1",
      "when": "final"
    }
  ],
  "measurements": [
    {
      "kind": "spawn-work-budget-v1",
      "subject": "mankey"
    }
  ]
}
