    {"id": "route-west", "op": "step", "args": {"frames": 64, "keys": ["LEFT"], "until": {"kind": "player-step-count", "operator": "eq", "value": 13}},
      "budget": {"maxSeconds": 20, "maxFrames": 64, "noProgressFrames": 32}},
