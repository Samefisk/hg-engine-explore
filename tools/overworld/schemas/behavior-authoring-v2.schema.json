{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior-authoring-v2.schema.json",
  "title": "Unified overworld behavior profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "schema",
    "fieldSchema",
    "generatedCompatibilityOutput",
    "rootProfile",
    "profiles",
    "selectors",
    "applications",
    "conditionalStates",
    "runtimeBindings"
  ],
  "properties": {
    "catalogVersion": { "const": 2 },
    "schema": {
      "const": "../tools/overworld/schemas/behavior-authoring-v2.schema.json"
    },
    "fieldSchema": { "const": "../tools/overworld/behavior_schema.json" },
    "generatedCompatibilityOutput": { "const": "OverworldWildBehaviorData.c" },
    "rootProfile": { "$ref": "#/$defs/id" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "selectors": {
      "type": "array",
      "maxItems": 65535,
      "items": { "$ref": "#/$defs/selector" }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/application" }
    },
    "conditionalStates": {
      "type": "array",
      "maxItems": 65535,
      "items": { "$ref": "#/$defs/conditionalState" }
    },
    "runtimeBindings": { "$ref": "#/$defs/runtimeBindings" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "expression": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "operatorValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value"],
      "properties": {
        "operator": {
          "enum": [
            "replace",
            "relative",
            "atLeast",
            "atMost",
            "relativeThenAtLeast",
            "relativeThenAtMost"
          ]
        },
        "value": { "$ref": "#/$defs/expression" },
        "threshold": { "type": "integer" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": ["relativeThenAtLeast", "relativeThenAtMost"]
              }
            }
          },
          "then": {
            "required": ["threshold"],
            "properties": { "value": { "type": "integer" } }
          },
          "else": { "not": { "required": ["threshold"] } }
        },
        {
          "if": {
            "properties": {
              "operator": { "enum": ["relative", "atLeast", "atMost"] }
            }
          },
          "then": { "properties": { "value": { "type": "integer" } } }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "parent", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "parent": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/operatorValue" }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupMask",
        "species",
        "terrain",
        "minLevel",
        "maxLevel",
        "shiny",
        "behaviorClass"
      ],
      "properties": {
        "groupMask": { "$ref": "#/$defs/expression" },
        "species": { "$ref": "#/$defs/expression" },
        "terrain": { "$ref": "#/$defs/expression" },
        "minLevel": { "$ref": "#/$defs/expression" },
        "maxLevel": { "$ref": "#/$defs/expression" },
        "shiny": { "$ref": "#/$defs/expression" },
        "behaviorClass": { "$ref": "#/$defs/expression" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "match", "members"],
      "properties": {
        "mode": { "enum": ["disabled", "members", "all"] },
        "match": { "$ref": "#/$defs/match" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/expression" }
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "match": { "$ref": "#/$defs/match" },
        "profile": { "$ref": "#/$defs/id" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "profile": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "conditionalState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentApplication",
        "application",
        "terrainMask",
        "terrainOverrideMask",
        "minMovementSpeed",
        "maxMovementSpeed"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parentApplication": { "$ref": "#/$defs/id" },
        "application": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "terrainMask": { "$ref": "#/$defs/expression" },
        "terrainOverrideMask": { "$ref": "#/$defs/expression" },
        "minMovementSpeed": { "$ref": "#/$defs/expression" },
        "maxMovementSpeed": { "$ref": "#/$defs/expression" }
      }
    },
    "runtimeBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classOrder",
        "speciesSelectors",
        "pickedUpProfile",
        "followerApplication",
        "defaultActiveApplication",
        "defaultTiredApplication",
        "forcedAsleepApplication",
        "forcedAsleepClassToken"
      ],
      "properties": {
        "classOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "symbol"],
            "properties": {
              "profile": { "$ref": "#/$defs/id" },
              "symbol": {
                "type": "string",
                "pattern": "^OW_WILD_BEHAVIOR_CLASS_[A-Za-z0-9_]+$"
              }
            }
          }
        },
        "speciesSelectors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "pickedUpProfile": { "$ref": "#/$defs/id" },
        "followerApplication": { "$ref": "#/$defs/id" },
        "defaultActiveApplication": { "$ref": "#/$defs/id" },
        "defaultTiredApplication": { "$ref": "#/$defs/id" },
        "forcedAsleepApplication": { "$ref": "#/$defs/id" },
        "forcedAsleepClassToken": { "$ref": "#/$defs/expression" }
      }
    }
  }
}
