{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior-authoring-v3.schema.json",
  "title": "Conditional overworld behavior profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "schema",
    "fieldSchema",
    "generatedCompatibilityOutput",
    "rootProfile",
    "profiles",
    "selectors",
    "applications",
    "runtimeBindings"
  ],
  "properties": {
    "catalogVersion": { "const": 3 },
    "schema": {
      "const": "../tools/overworld/schemas/behavior-authoring-v3.schema.json"
    },
    "fieldSchema": { "const": "../tools/overworld/behavior_schema.json" },
    "generatedCompatibilityOutput": { "const": "OverworldWildBehaviorData.c" },
    "rootProfile": { "$ref": "#/$defs/id" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "selectors": {
      "type": "array",
      "maxItems": 65535,
      "items": { "$ref": "#/$defs/selector" }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/application" }
    },
    "runtimeBindings": { "$ref": "#/$defs/runtimeBindings" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "expression": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "terrainExpression": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 1023 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "operatorValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value"],
      "properties": {
        "operator": {
          "enum": [
            "replace",
            "relative",
            "atLeast",
            "atMost",
            "relativeThenAtLeast",
            "relativeThenAtMost"
          ]
        },
        "value": { "$ref": "#/$defs/expression" },
        "threshold": { "type": "integer" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": ["relativeThenAtLeast", "relativeThenAtMost"]
              }
            }
          },
          "then": {
            "required": ["threshold"],
            "properties": { "value": { "type": "integer" } }
          },
          "else": { "not": { "required": ["threshold"] } }
        },
        {
          "if": {
            "properties": {
              "operator": { "enum": ["relative", "atLeast", "atMost"] }
            }
          },
          "then": { "properties": { "value": { "type": "integer" } } }
        }
      ]
    },
    "normalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "parent", "kind", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "parent": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "kind": { "const": "normal" },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/operatorValue" }
        }
      }
    },
    "conditionalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "parent", "kind", "conditions", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "parent": { "$ref": "#/$defs/id" },
        "kind": { "const": "conditional" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/condition" }
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/operatorValue" }
        }
      }
    },
    "profile": {
      "oneOf": [
        { "$ref": "#/$defs/normalProfile" },
        { "$ref": "#/$defs/conditionalProfile" }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupMask",
        "species",
        "terrain",
        "minLevel",
        "maxLevel",
        "shiny",
        "behaviorClass"
      ],
      "properties": {
        "groupMask": { "$ref": "#/$defs/expression" },
        "species": { "$ref": "#/$defs/expression" },
        "terrain": { "$ref": "#/$defs/expression" },
        "minLevel": { "$ref": "#/$defs/expression" },
        "maxLevel": { "$ref": "#/$defs/expression" },
        "shiny": { "$ref": "#/$defs/expression" },
        "behaviorClass": { "$ref": "#/$defs/expression" }
      }
    },
    "applicationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "match", "members"],
      "properties": {
        "mode": { "enum": ["disabled", "members", "all"] },
        "match": { "$ref": "#/$defs/match" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/expression" }
        }
      }
    },
    "inlineSubjectPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "match", "members"],
      "properties": {
        "mode": { "enum": ["members", "all"] },
        "match": { "$ref": "#/$defs/match" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/expression" }
        }
      }
    },
    "conditionSubjects": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["application"],
          "properties": { "application": { "$ref": "#/$defs/id" } }
        },
        { "$ref": "#/$defs/inlineSubjectPool" }
      ]
    },
    "terrainMotionCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "terrainMask",
        "terrainOverrideMask",
        "minMovementSpeed",
        "maxMovementSpeed"
      ],
      "properties": {
        "kind": { "const": "terrain-motion" },
        "terrainMask": { "$ref": "#/$defs/terrainExpression" },
        "terrainOverrideMask": { "$ref": "#/$defs/terrainExpression" },
        "minMovementSpeed": { "type": "integer", "minimum": 0, "maximum": 32 },
        "maxMovementSpeed": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "noticeTargetCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rangeKind",
        "rangeLength",
        "chancePercent",
        "adjacentDirectionMasks"
      ],
      "properties": {
        "kind": { "const": "notice-target" },
        "rangeKind": { "$ref": "#/$defs/expression" },
        "rangeLength": { "type": "integer", "minimum": 0, "maximum": 255 },
        "chancePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "adjacentDirectionMasks": { "$ref": "#/$defs/expression" }
      }
    },
    "conditionWhen": {
      "oneOf": [
        { "$ref": "#/$defs/terrainMotionCondition" },
        { "$ref": "#/$defs/noticeTargetCondition" }
      ]
    },
    "whileTrueActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "while-true" } }
    },
    "timedActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "durationFrames", "cooldownFrames"],
      "properties": {
        "mode": { "const": "timed" },
        "durationFrames": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cooldownFrames": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "conditionActivation": {
      "oneOf": [
        { "$ref": "#/$defs/whileTrueActivation" },
        { "$ref": "#/$defs/timedActivation" }
      ]
    },
    "conditionTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "player" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "roles", "selection", "groupMask", "members"],
          "properties": {
            "kind": { "const": "actor" },
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["wild", "follower"] }
            },
            "selection": { "const": "nearest" },
            "groupMask": { "$ref": "#/$defs/expression" },
            "members": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjects", "when", "activation", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subjects": { "$ref": "#/$defs/conditionSubjects" },
        "when": { "$ref": "#/$defs/conditionWhen" },
        "activation": { "$ref": "#/$defs/conditionActivation" },
        "target": { "$ref": "#/$defs/conditionTarget" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "when": {
                "properties": { "kind": { "const": "notice-target" } },
                "required": ["kind"]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "not": {
                  "properties": { "kind": { "const": "none" } },
                  "required": ["kind"]
                }
              }
            }
          }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "match": { "$ref": "#/$defs/match" },
        "profile": { "$ref": "#/$defs/id" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "profile": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/applicationTarget" }
      }
    },
    "runtimeBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classOrder",
        "speciesSelectors",
        "pickedUpProfile",
        "followerApplication",
        "defaultActiveApplication",
        "defaultTiredApplication",
        "forcedAsleepApplication",
        "forcedAsleepClassToken"
      ],
      "properties": {
        "classOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "symbol"],
            "properties": {
              "profile": { "$ref": "#/$defs/id" },
              "symbol": {
                "type": "string",
                "pattern": "^OW_WILD_BEHAVIOR_CLASS_[A-Za-z0-9_]+$"
              }
            }
          }
        },
        "speciesSelectors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "pickedUpProfile": { "$ref": "#/$defs/id" },
        "followerApplication": { "$ref": "#/$defs/id" },
        "defaultActiveApplication": { "$ref": "#/$defs/id" },
        "defaultTiredApplication": { "$ref": "#/$defs/id" },
        "forcedAsleepApplication": { "$ref": "#/$defs/id" },
        "forcedAsleepClassToken": { "$ref": "#/$defs/expression" }
      }
    }
  }
}
