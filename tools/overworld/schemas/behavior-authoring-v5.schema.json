{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior-authoring-v5.schema.json",
  "title": "Owned-subject overworld behavior profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "schema",
    "fieldSchema",
    "generatedCompatibilityOutput",
    "rootProfile",
    "profiles",
    "selectors",
    "pools",
    "applications",
    "runtimeBindings"
  ],
  "properties": {
    "catalogVersion": { "const": 5 },
    "schema": {
      "const": "../tools/overworld/schemas/behavior-authoring-v5.schema.json"
    },
    "fieldSchema": { "const": "../tools/overworld/behavior_schema.json" },
    "generatedCompatibilityOutput": { "const": "OverworldWildBehaviorData.c" },
    "rootProfile": { "$ref": "#/$defs/id" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "selectors": {
      "type": "array",
      "maxItems": 65535,
      "items": { "$ref": "behavior-authoring-v4.schema.json#/$defs/selector" }
    },
    "pools": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedPool" }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/application" }
    },
    "runtimeBindings": {
      "$ref": "#/$defs/runtimeBindings"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "profileClassification": {
      "enum": [
        "routine",
        "placement",
        "capability",
        "attitude",
        "style",
        "follower-mount",
        "modifier"
      ]
    },
    "normalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "parent", "kind", "fields"],
      "allOf": [
        {
          "if": {
            "properties": { "parent": { "$ref": "#/$defs/id" } },
            "required": ["parent"]
          },
          "then": { "required": ["classification"] }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "parent": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "kind": { "const": "normal" },
        "classification": { "$ref": "#/$defs/profileClassification" },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "behavior-authoring-v4.schema.json#/$defs/operatorValue"
          }
        }
      }
    },
    "conditionalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parent",
        "kind",
        "classification",
        "conditions",
        "fields"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "parent": { "$ref": "#/$defs/id" },
        "kind": { "const": "conditional" },
        "classification": { "$ref": "#/$defs/profileClassification" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/condition" }
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "behavior-authoring-v4.schema.json#/$defs/operatorValue"
          }
        }
      }
    },
    "profile": {
      "oneOf": [
        { "$ref": "#/$defs/normalProfile" },
        { "$ref": "#/$defs/conditionalProfile" }
      ]
    },
    "inlinePool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "match", "members"],
      "properties": {
        "mode": { "enum": ["members", "all"] },
        "match": { "$ref": "behavior-authoring-v4.schema.json#/$defs/match" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "behavior-authoring-v4.schema.json#/$defs/expression"
          }
        }
      }
    },
    "namedPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "match", "members"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["members", "all"] },
        "match": { "$ref": "behavior-authoring-v4.schema.json#/$defs/match" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "behavior-authoring-v4.schema.json#/$defs/expression"
          }
        }
      }
    },
    "poolReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool"],
      "properties": { "pool": { "$ref": "#/$defs/id" } }
    },
    "poolSelection": {
      "oneOf": [
        { "$ref": "#/$defs/inlinePool" },
        { "$ref": "#/$defs/poolReference" }
      ]
    },
    "actorPoolTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "roles", "selection", "pool"],
      "properties": {
        "kind": { "const": "actor" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["wild", "follower"] }
        },
        "selection": { "const": "nearest" },
        "pool": { "$ref": "#/$defs/id" }
      }
    },
    "conditionTarget": {
      "oneOf": [
        { "$ref": "behavior-authoring-v4.schema.json#/$defs/conditionTarget" },
        { "$ref": "#/$defs/actorPoolTarget" }
      ]
    },
    "currentVision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "current" } }
    },
    "customVision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "range", "cone", "adjacentAwareness"],
      "properties": {
        "mode": { "const": "custom" },
        "range": { "type": "integer", "minimum": 1, "maximum": 32 },
        "cone": { "const": "forward-90" },
        "adjacentAwareness": { "type": "boolean" }
      }
    },
    "visionSelection": {
      "oneOf": [
        { "$ref": "#/$defs/currentVision" },
        { "$ref": "#/$defs/customVision" }
      ]
    },
    "noticeTargetCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "vision", "chancePercent"],
      "properties": {
        "kind": { "const": "notice-target" },
        "vision": { "$ref": "#/$defs/visionSelection" },
        "chancePercent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "targetCannotSeeSubjectCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "vision", "chancePercent"],
      "properties": {
        "kind": { "const": "target-cannot-see-subject" },
        "vision": { "$ref": "#/$defs/visionSelection" },
        "chancePercent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "conditionWhen": {
      "oneOf": [
        {
          "$ref": "behavior-authoring-v4.schema.json#/$defs/terrainMotionCondition"
        },
        {
          "$ref": "behavior-authoring-v4.schema.json#/$defs/noticeTargetCondition"
        },
        { "$ref": "#/$defs/noticeTargetCondition" },
        { "$ref": "#/$defs/targetCannotSeeSubjectCondition" }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjects", "when", "activation", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subjects": { "$ref": "#/$defs/poolSelection" },
        "when": { "$ref": "#/$defs/conditionWhen" },
        "activation": {
          "$ref": "behavior-authoring-v4.schema.json#/$defs/conditionActivation"
        },
        "target": { "$ref": "#/$defs/conditionTarget" }
      }
    },
    "targetedApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "profile": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/poolSelection" }
      }
    },
    "linkedApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "profile": { "$ref": "#/$defs/id" }
      }
    },
    "application": {
      "oneOf": [
        { "$ref": "#/$defs/targetedApplication" },
        { "$ref": "#/$defs/linkedApplication" }
      ]
    },
    "runtimeBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classOrder",
        "speciesSelectors",
        "followerApplication",
        "mountedApplication",
        "defaultTiredApplication",
        "forcedAsleepApplication",
        "forcedAsleepClassToken"
      ],
      "properties": {
        "classOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "symbol"],
            "properties": {
              "profile": { "$ref": "#/$defs/id" },
              "symbol": {
                "type": "string",
                "pattern": "^OW_WILD_BEHAVIOR_CLASS_[A-Za-z0-9_]+$"
              }
            }
          }
        },
        "speciesSelectors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "followerApplication": { "$ref": "#/$defs/id" },
        "mountedApplication": { "$ref": "#/$defs/id" },
        "defaultTiredApplication": { "$ref": "#/$defs/id" },
        "forcedAsleepApplication": { "$ref": "#/$defs/id" },
        "forcedAsleepClassToken": {
          "$ref": "behavior-authoring-v4.schema.json#/$defs/expression"
        }
      }
    }
  }
}
